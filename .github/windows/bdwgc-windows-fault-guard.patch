--- a/os_dep.c
+++ b/os_dep.c
@@ -974,6 +974,62 @@
 
     GC_INNER JMP_BUF GC_jmp_buf;
 
+#   if defined(MSWIN32) && defined(__GNUC__) && defined(WRAP_MARK_SOME)
+    /* CRT signal() can allocate from the Windows process heap after the
+     * collector stops a thread holding that heap's lock (bdwgc issue #924).
+     * Install one independent VEH before collections, then only publish the
+     * collecting thread while the temporary read-fault guard is active. */
+    static PVOID GC_root_fault_handler_handle;
+    static volatile LONG GC_root_fault_thread_id;
+
+    static LONG CALLBACK GC_root_read_fault(PEXCEPTION_POINTERS info)
+    {
+        if (info->ExceptionRecord->ExceptionCode == EXCEPTION_ACCESS_VIOLATION
+            && info->ExceptionRecord->NumberParameters >= 2
+            && info->ExceptionRecord->ExceptionInformation[0] == 0
+            && (DWORD)InterlockedCompareExchange(&GC_root_fault_thread_id, 0, 0)
+                   == GetCurrentThreadId()) {
+          InterlockedExchange(&GC_root_fault_thread_id, 0);
+          LONGJMP(GC_jmp_buf, 1);
+        }
+        /* In particular, leave incremental write faults and unrelated
+         * threads to the application's existing exception handlers. */
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+
+    GC_INNER void GC_init_root_fault_handler(void)
+    {
+        if (GC_root_fault_handler_handle == NULL) {
+          /* Append rather than replacing a process-wide unhandled filter. */
+          GC_root_fault_handler_handle =
+              AddVectoredExceptionHandler(0, GC_root_read_fault);
+          if (GC_root_fault_handler_handle == NULL)
+            ABORT("AddVectoredExceptionHandler failed");
+        }
+    }
+
+    GC_INNER void GC_deinit_root_fault_handler(void)
+    {
+        InterlockedExchange(&GC_root_fault_thread_id, 0);
+        if (GC_root_fault_handler_handle != NULL) {
+          RemoveVectoredExceptionHandler(GC_root_fault_handler_handle);
+          GC_root_fault_handler_handle = NULL;
+        }
+    }
+
+    GC_INNER void GC_setup_temporary_fault_handler(void)
+    {
+        GC_ASSERT(I_HOLD_LOCK());
+        GC_ASSERT(GC_root_fault_handler_handle != NULL);
+        InterlockedExchange(&GC_root_fault_thread_id,
+                            (LONG)GetCurrentThreadId());
+    }
+
+    GC_INNER void GC_reset_fault_handler(void)
+    {
+        InterlockedExchange(&GC_root_fault_thread_id, 0);
+    }
+#   else
     STATIC void GC_fault_handler(int sig GC_ATTR_UNUSED)
     {
         LONGJMP(GC_jmp_buf, 1);
@@ -1005,6 +1061,8 @@
 #         endif
 #       endif
     }
+
+#   endif
 
